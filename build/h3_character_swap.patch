diff --git b/ffmpeg_tools.py b/ffmpeg_tools.py
new file mode 100644
index 0000000..9995e10
--- /dev/null
+++ b/ffmpeg_tools.py
@@ -0,0 +1,41 @@
+"""FFmpeg access on hosts without system FFmpeg/FFprobe.
+
+Comfy deployment patch (2026-10-16), not part of the upstream package: the Comfy
+build image ships the imageio-ffmpeg binary but no ffmpeg or ffprobe on PATH.
+ensure_ffmpeg_on_path() exposes the bundled binary as `ffmpeg`, and
+probe_video_stream() replaces the single ffprobe call with PyAV, returning the
+fields display_dimensions() reads in ffprobe's JSON shape.
+"""
+import os
+import shutil
+import tempfile
+
+import av
+
+
+def ensure_ffmpeg_on_path():
+    if shutil.which("ffmpeg"):
+        return
+    import imageio_ffmpeg
+    directory = tempfile.mkdtemp(prefix="h3-ffmpeg-")
+    os.symlink(imageio_ffmpeg.get_ffmpeg_exe(), os.path.join(directory, "ffmpeg"))
+    os.environ["PATH"] = directory + os.pathsep + os.environ.get("PATH", "")
+
+
+def probe_video_stream(path):
+    """First video stream as ffprobe would report it, or None if there is none."""
+    with av.open(path) as container:
+        if not container.streams.video:
+            return None
+        stream = container.streams.video[0]
+        sar = stream.sample_aspect_ratio
+        rotation = 0
+        for frame in container.decode(stream):
+            rotation = frame.rotation or 0
+            break
+        return {
+            "width": stream.width,
+            "height": stream.height,
+            "sample_aspect_ratio": f"{sar.numerator}:{sar.denominator}" if sar else "1:1",
+            "side_data_list": [{"rotation": rotation}] if rotation else [],
+        }
